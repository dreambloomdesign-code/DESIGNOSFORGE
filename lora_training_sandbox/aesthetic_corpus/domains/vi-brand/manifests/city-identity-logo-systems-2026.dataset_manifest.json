    "color_system": [
      "green and purple dynamic identity palette",
      "bright civic blue, orange, yellow and pink block palette",
      "green-to-lime network palette",
      "red and tan township icon palette",
      "black typography on white or light gray fields"
    ],
    "typography_system": "bold sans or condensed sans wordmarks, bilingual city names, master and sublogo lockups, exact-name risk controls, and strict spacing between mark and text",
    "anti_fragmentation_rules": [
      "start from one parent mark skeleton before generating variants",
      "derive sublogos from a shared grid, node map, letter skeleton or local-feature abstraction rule",
