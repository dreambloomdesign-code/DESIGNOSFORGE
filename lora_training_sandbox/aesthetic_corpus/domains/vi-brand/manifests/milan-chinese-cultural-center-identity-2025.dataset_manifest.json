  "design_dna": {
    "visual_positioning": "playful but ordered civic cultural identity for a Chinese cultural center in Milan, blending Swiss-modern grid discipline with modular cultural symbolism",
    "symbol_system": "modular circular C-like marks, arrow/notch cutouts, repeated grid patterns, symbol clusters, and color-coded direction logic",
    "composition_system": "large negative space, poster triptychs, two-column guideline boards, square social post grids, outdoor signage placements, and facade applications",
