      "deep oxblood brown",
      "cyan blue",
      "orange red",
      "pale yellow",
      "soft gray",
      "dark brown typography"
    ],
    "typography_system": "bold geometric sans typography, stacked bilingual institution names, Italian/English event copy, compact footer details, and guideline annotations",
    "application_system": [
      "poster",
      "logo extension",
      "T-shirt",
      "stamp",
      "wayfinding signage",
      "stationery",
      "business card",
      "outdoor billboard",
      "facade signage",
      "social media posts"
    ],
    "anti_fragmentation_rules": [
      "separate identity core marks from application mockups",
      "keep symbol repetition aligned to a grid or clear cluster logic",
      "use at most three accent colors per composition",
      "do not add decorative Chinese ornament unless it is part of an application image",
      "treat long multilingual copy as layout reference unless exact source text is supplied",
      "avoid mixing signage arrows, social UI chrome, and architectural photos in a single generated scene unless explicitly requested"
    ]
  },
